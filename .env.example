# WORKLENS Runtime Configuration

# Server
WORKLENS_HOST=0.0.0.0
WORKLENS_PORT=8000
WORKLENS_ENV=development
WORKLENS_LOG_LEVEL=INFO

# AI Reviewer Configuration
WORKLENS_MOCK_MODE=true
